# Optional TileVision image-storage settings (copy values into the ignored .env).
# Local storage is the development default and persists in the tilevision-media volume.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=media
STORAGE_LOCAL_URL_PREFIX=/media
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Set STORAGE_PROVIDER=s3 and STORAGE_S3_BUCKET to enable an S3-compatible provider.
# Leave endpoint empty for AWS S3; set it for compatible services such as MinIO.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_SIGNED_URL_TTL_SECONDS=300

# Image generation defaults to the OpenAI provider and gpt-image-1.5 model.
# Timeout defaults to 180 seconds; extra provider parameters default to {}.
# A real API key is required only when a deployment enables real OpenAI
# generation; it is optional for tests and stubbed provider flows.
IMAGE_EDIT_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_WITH_DEPLOYMENT_KEY
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_TIMEOUT_SECONDS=180
OPENAI_IMAGE_PARAMETERS={}

# Local storage persists in the tilevision-media Docker volume by default.
# For S3-compatible storage, static access/secret keys may be omitted when
# workload identity (or another AWS credential provider) supplies credentials.
